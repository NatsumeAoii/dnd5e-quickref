{
  "name": "dnd5e-quickref",
  "version": "1.3.0",
  "private": true,
  "description": "D&D 5e Quick Reference – Vite + TypeScript",
  "type": "module",
  "sideEffects": false,
  "module": "src/main.ts",
  "homepage": "https://natsumeaoii.github.io/dnd5e-quickref/",
  "repository": {
    "type": "git",
    "url": "https://github.com/NatsumeAoii/dnd5e-quickref.git"
  },
  "bugs": {
    "url": "https://github.com/NatsumeAoii/dnd5e-quickref/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "sync-version": "node scripts/prebuild.js",
    "migrate:ids": "node scripts/migrate-stable-ids.js && npm run sync-version",
    "release:build": "npm run build",
    "prebuild": "npm run sync-version",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "lint:css": "stylelint \"src/**/*.css\" --config config/.stylelintrc.json",
    "audit:data": "node scripts/audit-data.js",
    "check:sw": "node --check public/sw.js && node --check public/404.js",
    "check:generated": "node scripts/prebuild.js --check",
    "check:docs": "node scripts/check-docs.js",
    "test": "vitest run",
    "test:single": "vitest run --maxWorkers=1",
    "test:browser": "playwright test",
    "test:browser:headed": "playwright test --headed"
  },
  "keywords": [
    "dnd5e",
    "quick-reference",
    "vite",
    "typescript"
  ],
  "author": "NatsumeAoii and contributors",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "eslint": "^9.0.0",
    "fast-check": "^4.8.0",
    "jsdom": "^29.0.1",
    "lightningcss": "^1.32.0",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vite-plugin-checker": "^0.12.0",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "dompurify": "^3.4.8",
    "web-vitals": "^5.3.0"
  }
}
